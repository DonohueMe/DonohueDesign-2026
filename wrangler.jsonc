{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donohuedesign-2026",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "workers/**",
      "notes/**",
      ".git/**",
      "**/node_modules/**",
      ".wrangler/**"
    ]
  }
}
